{
  "name": "melissa-portfolio-chat-widget",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.widget.config.ts",
    "lint": "eslint . --max-warnings 0",
